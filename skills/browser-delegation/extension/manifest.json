{
  "manifest_version": 3,
  "name": "AI Agent 浏览器自动化桥接",
  "version": "1.1.0",
  "description": "专为 AI Agent 定制，无需重启 Chrome，自动在专属彩色标签组中执行自动化并自动清理",
  "permissions": [
    "tabs",
    "tabGroups",
    "debugger",
    "storage",
    "downloads",
    "cookies",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
